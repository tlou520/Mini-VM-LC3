{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug C++ with MSVC",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/lc3vm.exe",
      "args": ["tests/rogue.obj"],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "symbolSearchPath": "${workspaceFolder}"
    }
  ]
}
